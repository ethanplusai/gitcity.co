{
  "name": "gitcity",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "lint": "eslint src server shared tests",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "refresh:atlas": "node --env-file-if-exists=.env scripts/refresh-atlas.mjs",
    "format": "prettier --write src server/*.mjs shared scripts tests",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test:production-api": "node scripts/test-production-api.mjs",
    "check:release": "npm run lint && npm test && npm run test:production-api && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.453.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.180.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.1",
    "meshoptimizer": "^0.22.0",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": "24.x"
  }
}
